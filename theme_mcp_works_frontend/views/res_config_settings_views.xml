<odoo>
    <!-- Превключвателят follow/off в Settings → Website → General.
         Ключът е глобален (не по уебсайт), затова не е в блока,
         скрит при липсващ website_id. -->
    <record id="res_config_settings_view_form_mcp_frontend" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.mcp_frontend</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='website_info_settings']" position="inside">
                <setting id="mcp_site_mode_setting"
                         string="Website follows MCP theme"
                         help="Apply the MCP backend preset (accent, light/dark, radius, font) to the website, portal, shop, blog and login. Off restores the Website Builder theme.">
                    <field name="mcp_site_mode"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
