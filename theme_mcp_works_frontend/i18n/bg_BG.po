#. module: theme_mcp_works_frontend
#: model:ir.model.fields.selection,name:theme_mcp_works_frontend.selection__res_config_settings__mcp_site_mode__follow
msgid "Follow the MCP preset"
msgstr "Следва пресета на MCP"

#. module: theme_mcp_works_frontend
#: model:ir.model.fields,help:theme_mcp_works_frontend.field_res_config_settings__mcp_site_mode
msgid ""
"Follow: the public website, portal, shop, blog and login use the accent, "
"light/dark mode, radius and font of the backend preset; colours, fonts and "
"button shapes chosen in the Website Builder Theme tab are overridden. Off: "
"the website looks exactly as without this module."
msgstr ""
"Следва: публичният сайт, порталът, магазинът, блогът и входът ползват "
"акцента, светлия/тъмния режим, радиуса и шрифта на бекенд пресета; "
"цветовете, шрифтовете и формата на бутоните от таба „Тема“ на Website "
"Builder се засенчват. Изключено: сайтът изглежда точно както без този модул."

