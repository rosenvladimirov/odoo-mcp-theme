<templates xml:space="preserve">

    <t t-name="theme_mcp_works_backend.McpScrollBox">
        <div class="mcp_nav_scrollbox">
            <button t-if="state.up" type="button" class="mcp_nav_scroll_btn mcp_nav_scroll_up" tabindex="-1"
                    t-on-click.stop="() => this.scrollBy(-120)">
                <i class="fa fa-chevron-up" aria-hidden="true"/>
            </button>
            <div class="mcp_nav_scroll_body" t-ref="body" t-attf-style="max-height: {{ state.maxHeight }}px;">
                <div><t t-slot="default"/></div>
            </div>
            <button t-if="state.down" type="button" class="mcp_nav_scroll_btn mcp_nav_scroll_down" tabindex="-1"
                    t-on-click.stop="() => this.scrollBy(120)">
                <i class="fa fa-chevron-down" aria-hidden="true"/>
            </button>
        </div>
    </t>

    <!-- съдържанието на секцията — в кутията със стрелките -->
    <t t-name="theme_mcp_works_backend.NavBar.SectionsMenu" t-inherit="web.NavBar.SectionsMenu" t-inherit-mode="extension">
        <xpath expr="//t[@t-call='web.NavBar.SectionsMenu.Dropdown.MenuSlot']" position="replace">
            <McpScrollBox>
                <t t-call="web.NavBar.SectionsMenu.Dropdown.MenuSlot">
                    <t t-set="items" t-value="section.childrenTree"/>
                    <t t-set="decalage" t-value="20"/>
                </t>
            </McpScrollBox>
        </xpath>
    </t>

    <!-- „Още“ (секциите, които не се побират в навбара): същата кутия със
         стрелки, а секциите с подменюта са акордеон като групите -->
    <t t-name="theme_mcp_works_backend.NavBar.SectionsMenu.MoreDropdown" t-inherit="web.NavBar.SectionsMenu.MoreDropdown" t-inherit-mode="extension">
        <xpath expr="//t[@t-set-slot='content']/t[@t-foreach='sections']" position="replace">
            <McpScrollBox>
                <t t-foreach="sections" t-as="section" t-key="section.id">
                    <t t-if="!section.childrenTree.length">
                        <DropdownItem
                            class="'o_more_dropdown_section'"
                            onSelected="() => this.onNavBarDropdownItemSelection(section)"
                            t-esc="section.name"
                            attrs="{ href: getMenuItemHref(section), 'data-menu-xmlid': section.xmlid, 'data-section': section.id }"
                        />
                    </t>
                    <t t-else="">
                        <div class="o_more_dropdown_section o_more_dropdown_section_group dropdown-header bg-100 mcp_nav_group_toggle"
                             role="button"
                             t-att-aria-expanded="mcpNavGroups[section.id] ? 'true' : 'false'"
                             t-on-click.stop="() => this.mcpToggleNavGroup(section.id)"
                             t-esc="section.name"/>
                        <div t-if="mcpNavGroups[section.id]" class="mcp_nav_group_items">
                            <t t-call="web.NavBar.SectionsMenu.Dropdown.MenuSlot">
                                <t t-set="items" t-value="section.childrenTree"/>
                                <t t-set="decalage" t-value="20"/>
                            </t>
                        </div>
                    </t>
                </t>
            </McpScrollBox>
        </xpath>
    </t>

    <!-- групите — акордеон: заглавието отваря/затваря подменютата -->
    <t t-name="theme_mcp_works_backend.NavBar.MenuSlot" t-inherit="web.NavBar.SectionsMenu.Dropdown.MenuSlot" t-inherit-mode="extension">
        <xpath expr="//t[@t-else]" position="replace">
            <t t-else="">
                <div class="dropdown-menu_group dropdown-header mcp_nav_group_toggle" role="button"
                     t-att-style="style"
                     t-att-aria-expanded="mcpNavGroups[item.id] ? 'true' : 'false'"
                     t-on-click.stop="() => this.mcpToggleNavGroup(item.id)"
                     t-esc="item.name"/>
                <div t-if="mcpNavGroups[item.id]" class="mcp_nav_group_items">
                    <t t-call="web.NavBar.SectionsMenu.Dropdown.MenuSlot">
                        <t t-set="items" t-value="item.childrenTree"/>
                        <t t-set="decalage" t-value="decalage + 12"/>
                    </t>
                </div>
            </t>
        </xpath>
    </t>

</templates>
