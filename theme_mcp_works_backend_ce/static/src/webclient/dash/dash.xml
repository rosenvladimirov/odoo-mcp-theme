<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="theme_mcp_works_backend.McpDash">

        <!-- Backdrop — closes modal on click -->
        <div t-if="state.appsOpen and !state.pinned"
             class="mcp_modal_backdrop"
             t-on-click="() => { state.appsOpen = false; }"/>

        <!-- Modal panel -->
        <nav class="mcp_dash_modal d-print-none"
             t-att-class="{
                 'is-open':     state.appsOpen or state.pinned,
                 'is-pinned':   state.pinned,
                 'is-autohide': state.pinned and state.autoHide,
                 'is-peek':     state.pinned and state.autoHide and state.peek,
                 'is-compact':  state.viewMode === 0,
                 'is-list':     state.viewMode === 1,
                 'is-grid':     state.viewMode === 2
             }"
             t-on-mouseenter="onDockEnter"
             t-on-mouseleave="onDockLeave"
             t-ref="dock">

            <!-- Header: title (hidden in compact) + optional pager (grid) + toggle button always top-right -->
            <div class="mcp_dash_header">
                <div t-if="state.viewMode !== 0"
                     class="mcp_dash_header_title"
                     t-att-class="{ 'has-name': !!state.hoveredAppName }">
                    <span t-esc="state.hoveredAppName"/>
                </div>
                <div t-if="state.viewMode === 2 and gridPageCount > 1"
                     class="mcp_dash_pager">
                    <button class="mcp_dash_pager_btn"
                            t-att-disabled="state.gridPage === 0 ? 1 : undefined"
                            t-on-click.stop="onGridPrevPage">
                        <i class="fa fa-chevron-left" aria-hidden="true"/>
                    </button>
                    <span class="mcp_dash_pager_label">
                        <t t-esc="state.gridPage + 1"/>/<t t-esc="gridPageCount"/>
                    </span>
                    <button class="mcp_dash_pager_btn"
                            t-att-disabled="state.gridPage >= gridPageCount - 1 ? 1 : undefined"
                            t-on-click.stop="onGridNextPage">
                        <i class="fa fa-chevron-right" aria-hidden="true"/>
                    </button>
                </div>
                <button class="mcp_dash_mode_toggle"
                        t-att-title="state.viewMode === 0 ? 'Покажи имена' : state.viewMode === 1 ? 'Разгъни решетка' : 'Свий'"
                        t-on-click="onToggleViewMode">
                    <i t-if="state.viewMode === 0" class="fa fa-chevron-right" aria-hidden="true"/>
                    <i t-elif="state.viewMode === 1" class="fa fa-chevron-up" aria-hidden="true"/>
                    <i t-else="" class="fa fa-chevron-down" aria-hidden="true"/>
                </button>
            </div>

            <span class="mcp_dash_separator mcp_dash_sep_full"/>

            <!-- Scroll up -->
            <button t-if="state.canScrollUp"
                    class="mcp_dash_scroll_btn mcp_dash_scroll_up"
                    t-on-click="onScrollUp">
                <i class="fa fa-chevron-up" aria-hidden="true"/>
            </button>

            <!-- Apps area -->
            <div class="mcp_dash_apps_scroll" t-ref="appsScroll">
                <t t-foreach="currentApps" t-as="app" t-key="app.id">
                    <a href="#"
                       class="mcp_dash_item"
                       t-att-class="{ 'is-active': app.id === state.currentAppId }"
                       t-on-click.prevent="() => this.onAppClick(app)"
                       t-on-mouseenter="(ev) => this.onAppMouseEnter(app, ev)"
                       t-on-mouseleave="onAppMouseLeave">
                        <!-- иконката: рисувана от темата, родната на модула или буква -->
                        <McpAppIcon app="app"/>
                        <!-- надписът е в списъка (1) и в решетката (2); компактният (0) показва балонче -->
                        <span t-if="state.viewMode !== 0" class="mcp_dash_label" t-esc="app.name"/>
                    </a>
                </t>
            </div>

            <!-- Scroll down -->
            <button t-if="state.canScrollDown"
                    class="mcp_dash_scroll_btn mcp_dash_scroll_down"
                    t-on-click="onScrollDown">
                <i class="fa fa-chevron-down" aria-hidden="true"/>
            </button>

            <!-- Закачане и автоскриване (решетката е модал — там няма закачане) -->
            <div t-if="state.viewMode !== 2" class="mcp_dash_footer">
                <button type="button"
                        class="mcp_dash_footer_btn mcp_dash_pin"
                        t-att-class="{ 'is-on': state.pinned }"
                        t-att-title="pinTitle"
                        t-att-aria-pressed="state.pinned ? 'true' : 'false'"
                        t-on-click.stop="onTogglePin">
                    <i class="fa fa-thumb-tack" aria-hidden="true"/>
                </button>
                <button t-if="state.pinned" type="button"
                        class="mcp_dash_footer_btn mcp_dash_autohide"
                        t-att-class="{ 'is-on': state.autoHide }"
                        t-att-title="autoHideTitle"
                        t-att-aria-pressed="state.autoHide ? 'true' : 'false'"
                        t-on-click.stop="onToggleAutoHide">
                    <i class="fa fa-eye-slash" aria-hidden="true"/>
                </button>
                <!-- катинарчето пуска скрийнсейвъра; вижда се само ако има такъв
                     (конфигураторът слага <html data-mcp-ss-ready>) -->
                <button type="button"
                        class="mcp_dash_footer_btn mcp_dash_lock"
                        t-att-title="lockTitle"
                        t-on-click.stop="onLock">
                    <i class="fa fa-lock" aria-hidden="true"/>
                </button>
            </div>

            <!-- Compact mode: name bubble to the right -->
            <div t-if="state.viewMode === 0 and state.hoveredAppName"
                 class="mcp_dash_name_bubble"
                 t-att-style="'top: ' + (state.hoveredY - 12) + 'px'">
                <t t-esc="state.hoveredAppName"/>
            </div>

        </nav>
    </t>

</templates>
