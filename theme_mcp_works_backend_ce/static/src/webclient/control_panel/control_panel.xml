<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <!-- Apps menu: add icon + name to each item (replaces muk_web_theme role) -->
    <t t-name="theme_mcp_works_backend.NavBar.AppsMenu" t-inherit="web.NavBar.AppsMenu" t-inherit-mode="extension">
        <xpath expr="//DropdownItem[@t-foreach='apps']" position="replace">
            <DropdownItem
                t-foreach="apps"
                t-as="app"
                t-key="app.id"
                class="{ 'o_app': true, focus: menuService.getCurrentApp() === app }"
                onSelected="() => this.onNavBarDropdownItemSelection(app)"
                attrs="{ href: getMenuItemHref(app), 'data-menu-xmlid': app.xmlid, 'data-section': app.id }"
            >
                <!-- иконката от темата; без нея — родната (или общата на base) -->
                <McpAppIcon t-if="app.webIconData" app="app" imgClass="'mcp_app_icon'"/>
                <img t-else=""
                     class="mcp_app_icon"
                     src="/base/static/description/icon.png"
                     t-att-alt="app.name"/>
                <span class="mcp_app_name" t-esc="app.name"/>
            </DropdownItem>
        </xpath>
    </t>


    <!-- Force list-view (single-segment) breadcrumbs to use the same
         <ol class="breadcrumb"><li class="breadcrumb-item active">…</li></ol>
         structure as the multi-segment branch, so SCSS rules and DOM stay
         uniform regardless of whether there's 1 or N path entries. -->
    <t t-name="theme_mcp_works_backend.Breadcrumbs" t-inherit="web.Breadcrumbs" t-inherit-mode="extension">
        <xpath expr="//div[@t-else=''][hasclass('o_breadcrumb')]" position="replace">
            <div t-else="" class="o_breadcrumb d-flex flex-row flex-md-column align-self-stretch justify-content-between min-w-0">
                <ol class="breadcrumb flex-nowrap text-nowrap lh-sm">
                    <li class="breadcrumb-item d-inline-flex min-w-0 active">
                        <span class="fw-bold text-truncate"><t t-call="web.Breadcrumb.Name"/></span>
                    </li>
                </ol>
                <t t-call="web.Breadcrumb.Actions"/>
            </div>
        </xpath>
    </t>

</templates>
