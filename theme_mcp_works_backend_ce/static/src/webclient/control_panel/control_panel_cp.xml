<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <!-- Лентата с пътечката и преместените действия. Отделен файл, зареден
         веднага след web/.../control_panel.xml (виж манифеста): в Odoo 19
         разширение стига само до основните наследници (t-inherit без mode),
         заредени СЛЕД него — иначе project.ProjectTaskControlPanel (задачите
         в проект) е копие без лентата и пътечката изчезва (Росен, 25.10.2026). -->
    <t t-name="theme_mcp_works_backend.ControlPanel" t-inherit="web.ControlPanel" t-inherit-mode="extension">

        <!-- (0) Вградените действия (Задачи, Графици, Табло…) като падащо меню
             вдясно от „Нов“ — версия 1 (Росен, 25.10.2026): иконата „слоеве“ и
             името на текущото действие. Горе са избраните за лентата, под тях
             „Още“; после отметката за отделния ред и „Запази изгледа“.
             Бутонът на ядрото до изгледите е скрит в SCSS (control_panel_strip). -->
        <xpath expr="//div[hasclass('o_control_panel_main_buttons')]/t[@t-slot='control-panel-always-buttons']" position="after">
            <Dropdown t-if="state.embeddedInfos.embeddedActions?.length and !env.isSmall"
                      menuClass="'mcp_embedded_menu'">
                <button class="btn btn-secondary mcp_embedded_toggle" title="Related views">
                    <svg class="mcp_embedded_icon" viewBox="0 0 24 24" width="16" height="16" fill="none"
                         stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
                         aria-hidden="true">
                        <path d="M12 3 3 8l9 5 9-5-9-5Z"/>
                        <path d="m3 13 9 5 9-5"/>
                    </svg>
                    <span t-if="state.embeddedInfos.currentEmbeddedAction?.name" class="mcp_embedded_name"
                          t-out="state.embeddedInfos.currentEmbeddedAction.name"/>
                    <span t-else="" class="mcp_embedded_name">Views</span>
                    <i class="fa fa-caret-down ms-1" aria-hidden="true"/>
                </button>
                <t t-set-slot="content">
                    <t t-set="mcpPinned" t-value="state.embeddedInfos.embeddedActions.filter((a) => this._isEmbeddedActionVisible(a))"/>
                    <t t-set="mcpOther" t-value="state.embeddedInfos.embeddedActions.filter((a) => !this._isEmbeddedActionVisible(a))"/>
                    <h6 class="dropdown-header">Related views</h6>
                    <t t-foreach="mcpPinned" t-as="action" t-key="action.id">
                        <DropdownItem class="{ 'selected': state.embeddedInfos.currentEmbeddedAction?.id === action.id }"
                                      onSelected="() => this.onEmbeddedActionClick(action)">
                            <span t-out="action.name"/>
                        </DropdownItem>
                    </t>
                    <t t-if="mcpOther.length">
                        <h6 t-if="mcpPinned.length" class="dropdown-header">More</h6>
                        <t t-foreach="mcpOther" t-as="action" t-key="action.id">
                            <DropdownItem class="{ 'selected': state.embeddedInfos.currentEmbeddedAction?.id === action.id }"
                                          onSelected="() => this.onEmbeddedActionClick(action)">
                                <span t-out="action.name"/>
                            </DropdownItem>
                        </t>
                    </t>
                    <div role="separator" class="dropdown-divider"/>
                    <DropdownItem class="{ 'selected': state.embeddedInfos.showEmbedded, 'mcp_embedded_bar_toggle': true }"
                                  onSelected="() => this.onClickShowEmbedded()">
                        Show as a separate row
                    </DropdownItem>
                    <!-- „Запази изгледа“ като в ядрото; при показан ред е там (t-ref е един) -->
                    <AccordionItem t-if="!state.embeddedInfos.showEmbedded" class="'o_save_current_view'" description.translate="Save View">
                        <div class="px-2 py-2">
                            <input type="text" t-ref="newActionNameRef" class="o_input mb-2"
                                   t-model.trim="state.embeddedInfos.newActionName"/>
                            <CheckBox value="state.embeddedInfos.newActionIsShared" onChange.bind="_onShareCheckboxChange">
                                <span data-tooltip="Make this embedded action available to other users">Shared</span>
                            </CheckBox>
                        </div>
                        <div class="px-3 py-2">
                            <button class="o_save_favorite btn btn-primary w-100" t-on-click="_saveNewAction">Save</button>
                        </div>
                    </AccordionItem>
                </t>
            </Dropdown>
        </xpath>

        <!-- (1) Inject the breadcrumb strip BEFORE .o_control_panel_main.
             The leading marker is the relocated .o_menu_brand: shows the
             current app's icon + name (the original in the navbar is
             hidden via SCSS — see navbar.scss). -->
        <xpath expr="//div[hasclass('o_control_panel_main')]" position="before">
            <div t-if="!env.config.noBreadcrumbs and !env.isSmall"
                 class="mcp_breadcrumb_strip d-print-none">
                <t t-set="mcpCurrentApp" t-value="env.services.menu and env.services.menu.getCurrentApp()"/>
                <a t-if="mcpCurrentApp"
                   class="mcp_breadcrumb_steps mcp_app_brand"
                   t-att-href="'/odoo/' + (mcpCurrentApp.actionPath or ('action-' + mcpCurrentApp.actionID))"
                   t-att-data-menu-xmlid="mcpCurrentApp.xmlid"
                   t-att-data-section="mcpCurrentApp.id"
                   t-att-title="mcpCurrentApp.name">
                    <!-- иконката от темата; без нея — родната, а без родна — маркер -->
                    <McpAppIcon t-if="mcpCurrentApp.webIconData" app="mcpCurrentApp" imgClass="'mcp_app_brand_icon'"/>
                    <i t-else="" class="fa fa-map-marker" aria-hidden="true"/>
                    <span class="mcp_app_brand_name" t-esc="mcpCurrentApp.name"/>
                </a>
                <i t-else="" class="mcp_breadcrumb_steps fa fa-map-marker" aria-hidden="true"/>
                <button type="button"
                        class="mcp_scroll_btn mcp_scroll_left"
                        aria-label="Scroll left"
                        hidden="hidden">
                    <i class="fa fa-chevron-left" aria-hidden="true"/>
                </button>
                <div class="mcp_breadcrumb_scroll">
                    <Breadcrumbs breadcrumbs="breadcrumbs"/>
                </div>
                <button type="button"
                        class="mcp_scroll_btn mcp_scroll_right"
                        aria-label="Scroll right"
                        hidden="hidden">
                    <i class="fa fa-chevron-right" aria-hidden="true"/>
                </button>
            </div>
        </xpath>

        <!-- (2) Drop the breadcrumb-additional-actions slot from original Breadcrumbs.
             This stops the cog from rendering inside .o_control_panel_breadcrumbs. -->
        <xpath expr="//div[hasclass('o_control_panel_breadcrumbs')]//t[@t-set-slot='breadcrumb-additional-actions']" position="replace"/>

        <!-- (3) Re-render the slot inside .o_control_panel_navigation (next to view switchers). -->
        <xpath expr="//div[hasclass('o_control_panel_navigation')]" position="inside">
            <div class="mcp_relocated_actions d-flex align-items-center"
                 t-if="!env.config.noBreadcrumbs and !env.isSmall">
                <t t-slot="control-panel-additional-actions"/>
                <span class="mcp_view_separator"/>
            </div>
        </xpath>

    </t>

</templates>
